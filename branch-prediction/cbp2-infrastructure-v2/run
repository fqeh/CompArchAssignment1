#!/usr/bin/env python3
"""Run the branch predictor on every trace and print the mean MPKI."""

from pathlib import Path
import subprocess
import sys


def main():
    if len(sys.argv) != 2:
        raise ValueError(f"Usage: {sys.argv[0]} <trace-file-directory>")
    trace_dir = Path(sys.argv[1])
    if not trace_dir.is_dir():
        raise ValueError(f"Trace directory does not exist: {trace_dir}")
    traces = sorted(path for path in trace_dir.rglob("*.trace.*") if path.is_file())
    if not traces:
        raise ValueError(f"No trace files found in {trace_dir}")
    predictor = Path(__file__).resolve().parent / "src" / "predict"
    if not predictor.is_file():
        raise ValueError("predict program is not built; run make -C src first.")

    total = 0.0
    for trace in traces:
        result = subprocess.run(
            [str(predictor), str(trace)],
            check=True, text=True, stdout=subprocess.PIPE,
        )
        fields = result.stdout.strip().splitlines()[-1].split()
        if len(fields) != 2 or fields[1] != "MPKI":
            raise ValueError(f"Unexpected predictor output for {trace}")
        mpki = float(fields[0])
        total += mpki
        print(f"{str(trace):40s}\t{mpki:.3f}", flush=True)
    print(f"average MPKI: {total / len(traces):.3f}")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
