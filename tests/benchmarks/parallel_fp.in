# Tomasulo benchmark. Author: Ali Alfageeh
# Unit             RS  EX  MEM FUs
Integer adder       8   1      1
FP adder            8   3      2
FP multiplier       8   8      2
Load/store unit     8   1   4  1
ROB entries = 32

# Two FP adders/multipliers exercise concurrent pipeline starts and CDB arbitration.
F20=2,F21=3,F22=4
Mult.d F1 F20 F21
Add.d F2 F20 F21
Mult.d F3 F20 F22
Add.d F4 F21 F22
Mult.d F5 F21 F22
Add.d F6 F20 F22
Add.d F7 F1 F2
Add.d F8 F3 F4
Add.d F9 F5 F6
