# Tomasulo benchmark. Author: Ali Alfageeh
# Unit             RS  EX  MEM FUs
Integer adder       8   1      1
FP adder            8   3      1
FP multiplier       8   8      1
Load/store unit     8   1   4  1
ROB entries = 32

# Taken BEQ/BNE squash wrong-path store/register writes and recover RAT.
F1=9,Mem[0]=3
Addi R1 R0 1
Beq R1 R1 2
Sd F1 0(R0)
Addi R2 R0 99
Addi R2 R0 7
Bne R1 R0 1
Addi R3 R0 99
Add R3 R2 R1
