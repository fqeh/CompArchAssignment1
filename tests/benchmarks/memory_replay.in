# Tomasulo benchmark. Author: Ali Alfageeh
# Unit             RS  EX  MEM FUs
Integer adder       8  12      1
FP adder            8   3      1
FP multiplier       8   8      1
Load/store unit     8   1   1  1
ROB entries = 32

# Load initially bypasses older unresolved store; alias resolution must replay load and consumer.
F1=7,Mem[4]=1
Addi R1 R0 4
Sd F1 0(R1)
Ld F2 4(R0)
Add.d F3 F2 F2
