# Tomasulo benchmark. Author: Ali Alfageeh
# Unit             RS  EX  MEM FUs
Integer adder       8   1      1
FP adder            8   3      1
FP multiplier       8   8      1
Load/store unit     8   1   4  1
ROB entries = 32

# Case-insensitive commas, two-digit registers and last valid word address.
r0=0,f31=4.5,f1=1.25
aDdI r31, r0, 252
sD f31, 0(r31)
lD f30, 0(r31)
sUb.D f29, f30, f1
aDd r30, r31, r0
