# Tomasulo benchmark. Author: Ali Alfageeh
# Unit             RS  EX  MEM FUs
Integer adder       8   1      1
FP adder            8   3      1
FP multiplier       8   8      1
Load/store unit     8   1   4  1
ROB entries = 32

# Youngest matching older store must forward 7, not older store value 2.
F1=2,F2=7,Mem[0]=99
Mult.d F10 F1 F2
Sd F1 0(R0)
Sd F2 0(R0)
Ld F3 0(R0)
Add.d F4 F3 F1
