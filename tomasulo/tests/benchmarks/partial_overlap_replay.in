# Tomasulo benchmark. Author: Ali Alfageeh
# Unit             RS  EX  MEM FUs
Integer adder       8  12      1
FP adder            8   3      1
FP multiplier       8   8      1
Load/store unit     8   1   1  1
ROB entries = 32

# Newer store masks only2bytes; older unresolved store still requires replay for2other bytes.
F1=2,F2=1
Addi R1 R0 2
Sd F1 0(R1)
Sd F2 0(R0)
Ld F3 2(R0)
Add.d F4 F3 F3
