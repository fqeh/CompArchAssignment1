# Tomasulo benchmark. Author: Ali Alfageeh
# Unit             RS  EX  MEM FUs
Integer adder       8   1      1
FP adder            8   3      1
FP multiplier       8   8      1
Load/store unit     8   1   4  1
ROB entries = 32

# Overlapping binary32 stores merge bytes; F3=0,F4=2,F5=2.
F1=1,F2=2
Mult.d F30 F1 F2
Sd F1 18(R0)
Sd F2 20(R0)
Ld F3 18(R0)
Ld F4 20(R0)
Add.d F5 F3 F4
