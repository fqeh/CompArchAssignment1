# Tomasulo benchmark. Author: Ali Alfageeh
# Unit             RS  EX  MEM FUs
Integer adder       8   1      1
FP adder            8   3      1
FP multiplier       8   8      1
Load/store unit     8   1   4  1
ROB entries = 32

# Assignment-style effective byte address 10+8=18; finite straight-line example.
R1=10,R2=20,F2=30.1
Mem[18]=16777217
Add.d F1, F2, F3
Ld F4, 8(R1)
Sd F4, 22(R1)
Addi R3, R2, 1
