# Tomasulo benchmark. Author: Ali Alfageeh
# Unit             RS  EX  MEM FUs
Integer adder       8   1      1
FP adder            8   3      1
FP multiplier       8   8      1
Load/store unit     8   1   4  1
ROB entries = 32

# Ld/Sd round16777217 to16777216, including forwarding; .d arithmetic retains precision.
F1=16777217,F2=1
Mem[28]=16777217
Mult.d F30 F1 F2
Sd F1 18(R0)
Ld F3 18(R0)
Add.d F4 F1 F2
Ld F5 28(R0)
